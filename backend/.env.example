# ============================================
# 单人博客一体化部署 - 环境变量配置文件
# ============================================
# 使用方式：
#   1. 复制本文件为 .env
#   2. 至少修改 ADMIN_PASSWORD 和 JWT_SECRET
#   3. 与 selfblog.jar 放在同一目录，运行 java -jar selfblog.jar
#
# 【重要】.env 文件不会提交到 Git（已在 .gitignore 中）
# ============================================

# ==================== 数据库配置（必需） ====================
# 数据库类型：mysql 或 sqlite
# - mysql: 使用 MySQL 数据库（需要配置下方 DB_HOST 等参数）
# - sqlite: 使用 SQLite 本地文件数据库（只需配置 DB_URL_SQLITE）
DB_TYPE=sqlite

# # --- MySQL 配置（DB_TYPE=mysql 时需要） ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=campus_blog
# DB_USERNAME=root
# DB_PASSWORD=

# --- SQLite 配置（DB_TYPE=sqlite 时需要） ---
# SQLite 数据库文件路径（支持相对路径或绝对路径）
DB_URL_SQLITE=jdbc:sqlite:campus_blog.db

# ==================== JWT 配置（必需） ====================
# JWT 密钥（必须自行生成至少 32 位的随机字符串）
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# 访客/IP 伪名化密钥（可选，建议单独设置一把）
# 访客去重、ip_hash、匿名点赞与游客留言的访客标识都先用 HMAC-SHA256 派生再入库，
# 不再明文保存 IP。不设置时回落到 JWT_SECRET；两者都缺失则启动即失败。
# VISITOR_HASH_SECRET=

# 首次启动创建作者管理员；修改后台密码请在后台账户设置中完成
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=站长
# 首次启动时的后台入口，之后也可在后台设置中修改
ADMIN_PATH=admin

# ==================== 服务配置 ====================
# 应用端口
SERVER_PORT=8825

# 是否启用 API 文档（Knife4j / Swagger UI；prod profile 下整体关闭）
# SWAGGER_ENABLED=true

# 站点对外地址（可选，用于 RSS/Atom 订阅源与 sitemap.xml 里的绝对链接）
# 部署在 Nginx/Cloudflare 等反向代理后时建议显式设置，否则按请求头推导，
# 可能得到内网地址或容器地址。示例：SITE_BASE_URL=https://blog.example.com
# SITE_BASE_URL=

# ==================== 邮件服务配置（用于密码找回） ====================
# 邮件发送服务器地址
MAIL_HOST=smtp.example.com
# 邮件发送端口（TLS 通常为 587，SSL 通常为 465）
MAIL_PORT=587
# 是否启用 SSL（默认 true；使用 STARTTLS 的 587 端口时可设为 false）
# MAIL_SSL_ENABLED=true
# SMTP 认证邮箱账号（通常是发件人邮箱）
MAIL_USERNAME=your_email@example.com
# 邮箱密码或授权码
MAIL_PASSWORD=your_email_password_or_api_key
# 发件人显示地址（如与 MAIL_USERNAME 不同则单独设置，否则可省略）
MAIL_FROM=noreply@example.com
# 本地没有 SMTP 时：设为 true 后跳过真实发信，把验证码打到日志里，便于自测。
# 【重要】生产环境必须保持默认 false，否则任何能读日志的人都能重置后台密码。
# MAIL_DEV_CONSOLE_CODE=false

# ==================== 可信代理白名单（可选） ====================
# 只有来自这些地址的请求才允许用 X-Forwarded-For / X-Real-IP 改写客户端 IP，
# 其他来源一律忽略这些头、直接用 TCP 对端地址。默认仅回环。
# 反代与 JAR 不同机时，把反代地址加进来，例如：127.0.0.1/32,::1/128,10.0.0.5/32
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ==================== CORS 配置（可选） ====================
# 允许的跨域来源，多个来源用逗号分隔
# 示例: http://localhost:3000,http://localhost:8825
# 【重要】生产环境请务必设置具体的域名，禁止使用 * 通配符
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8825

# ==================== 头像域名白名单 ====================
# 允许设置头像的域名白名单，多个用逗号分隔
AVATAR_ALLOWED_DOMAINS=localhost,127.0.0.1

# ==================== 文件上传配置（可选） ====================
# 单文件最大上传大小（字节），默认 52428800 (50MB)
UPLOAD_MAX_FILE_SIZE=52428800
# 单次请求最大上传大小（字节），默认 104857600 (100MB)
UPLOAD_MAX_REQUEST_SIZE=104857600

# ==================== 缓存与环境验证配置（可选） ====================
# 是否启用环境变量验证（生产环境建议设为 true）
ENV_VALIDATION_ENABLED=true

# ==================== 其他可选配置 ====================
# MyBatis SQL 日志配置
# MYBATIS_SQL_LOG=org.apache.ibatis.logging.stdout.StdOutImpl (开启SQL日志)
# MYBATIS_SQL_LOG=org.apache.ibatis.logging.nologging.NoLoggingImpl (关闭SQL日志)

# 邮件健康检查（配置真实SMTP后设为 true 以启用）
# MAIL_HEALTH_ENABLED=true

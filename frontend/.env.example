# =============================================================================
# SelfBlog前端 - 统一环境配置
# =============================================================================
# Vite 会自动加载此文件，开发/生产环境通用
# 如需覆盖，可创建 .env.local（不提交到 git）

# API 基础路径（保留位：axios 在 src/api/index.ts 硬编码 /api，此项当前未被消费）
VITE_API_BASE_URL=/api

# 应用信息
# VITE_APP_TITLE 由代码消费（页面标题兜底）
VITE_APP_TITLE=个人博客
# VITE_APP_VERSION 为保留位，当前未被代码消费
VITE_APP_VERSION=2.0.25

# 开发环境专用：后端代理目标地址（vite.config.ts 消费）
# 生产环境由后端单 JAR 直接服务，或通过 vercel.json 的 rewrites 代理，无需此配置
VITE_API_TARGET=http://localhost:8825

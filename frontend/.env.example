# =============================================================================
# SelfBlog前端 - 统一环境配置
# =============================================================================
# Vite 会自动加载此文件，开发/生产环境通用
# 如需覆盖，可创建 .env.local（不提交到 git）

# API 基础路径（所有环境相同）
VITE_API_BASE_URL=/api

# 应用信息
VITE_APP_TITLE=个人博客
VITE_APP_VERSION=2.0.25

# 开发环境专用：后端代理目标地址
# 生产环境通过 vercel.json 的 rewrites 代理，无需此配置
VITE_API_TARGET=http://localhost:8825
